# Normalise line endings: LF in the repository and in every working copy
# (Windows and Mac alike), so diffs never show whole files as changed.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.parquet binary
*.npz binary
*.zip binary

# The lockfile is generated by uv; collapse it in GitHub diffs
uv.lock linguist-generated=true
