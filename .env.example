# Copy to .env in the repository root and fill in. Never commit .env.
# Supabase -> Connect -> Session pooler (port 5432). The direct db.<ref>.supabase.co
# address is IPv6-only and does not work from GitHub Actions or many home networks.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# LOG_LEVEL (DEBUG/INFO/WARNING) must be set in the shell, not here: logging starts
# before .env is read. Example (PowerShell): $env:LOG_LEVEL="DEBUG"
