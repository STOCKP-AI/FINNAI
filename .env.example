# Copy to .env in the repository root (or backend/.env for the AI keys) and fill in.
# Never commit .env. Files read: ml/.env, .env, backend/.env (later ones win).
# Supabase -> Connect -> Session pooler (port 5432). The direct db.<ref>.supabase.co
# address is IPv6-only and does not work from GitHub Actions or many home networks.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- AI analyst (backend) -------------------------------------------------------------
# Free tier, no billing account linked (overuse = rate-limit errors, never a bill).
# Google AI Studio -> Get API key. Without a key, use LLM_PROVIDER=mock.
LLM_PROVIDER=gemini
LLM_API_KEY=<Google AI Studio key>
# LLM_MODEL=gemini-3.8-flash          # default; any free Flash model listed in AI Studio
# Backup: LLM_PROVIDER=groq, LLM_API_KEY=<Groq key>  (model default openai/gpt-oss-120b)

# Automatic fallback: when Gemini is busy or rate-limited (HTTP 429/503) after short retries,
# this model answers instead (default model openai/gpt-oss-120b).
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_API_KEY=<Groq key>

# Eval judge: a different model from the one being tested (uv run mm-evals)
JUDGE_PROVIDER=groq
JUDGE_API_KEY=<Groq key>
JUDGE_MODEL=qwen/qwen3.8-27b   # not the fallback model, so no model grades its own answers

# Chat limit per visitor: the IP is stored only as HMAC(IP_HASH_PEPPER, ip).
# Any long random string, e.g. from: uv run python -c "import secrets; print(secrets.token_hex(32))"
IP_HASH_PEPPER=<random string>
# CHAT_DAILY_LIMIT=10
# CORS_ORIGINS=http://localhost:5173          # exact origins, comma-separated, never '*'
# NSE_HOLIDAYS=2026-10-02                     # NSE holidays (comma-separated): no false "stale" flag

# LOG_LEVEL (DEBUG/INFO/WARNING) must be set in the shell, not here: logging starts
# before .env is read. Example (PowerShell): $env:LOG_LEVEL="DEBUG"
